{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/Corpro.Api/Corpro.Api.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-web",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/Corpro.Web/Corpro.Web.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-todo",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Corpro.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "watch-api",
      "detail": "API con recarga en caliente (sin depurador)",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/src/Corpro.Api", "--launch-profile", "http"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch-web",
      "detail": "Blazor con recarga en caliente (sin depurador)",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/src/Corpro.Web", "--launch-profile", "http"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    }
  ]
}
