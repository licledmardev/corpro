{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (Corpro.Api)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/Corpro.Api/bin/Debug/net10.0/Corpro.Api.dll",
      "cwd": "${workspaceFolder}/src/Corpro.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5172"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Web (Corpro.Web - Blazor)",
      "type": "blazorwasm",
      "request": "launch",
      "preLaunchTask": "build-web",
      "cwd": "${workspaceFolder}/src/Corpro.Web",
      "url": "http://localhost:5032",
      "browser": "edge"
    }
  ],
  "compounds": [
    {
      "name": "API + Web",
      "configurations": ["API (Corpro.Api)", "Web (Corpro.Web - Blazor)"],
      "stopAll": true
    }
  ]
}
